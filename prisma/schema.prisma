generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// SQLite no soporta enums nativos de Prisma: role/lineaNegocio/status se
// guardan como String y se validan en la capa de aplicación contra los
// catálogos definidos en `src/lib/domain.ts` (Rol, LineaNegocio, EstadoUsuario).
model User {
  id                       String    @id @default(cuid())
  name                     String
  email                    String    @unique
  passwordHash             String?
  role                     String
  lineaNegocio             String
  status                   String    @default("ACTIVO")
  activationToken          String?   @unique
  activationTokenExpiresAt DateTime?
  lastAccessAt             DateTime?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt
}
